msgid "Close"
msgstr "Хаах"

#: crates/ui-egui/src/lib.rs:6187
msgid "Close Family"
msgstr "Бүлийг хаах"

#: crates/ui-egui/src/lib.rs:4861
msgid "Close Inactive"
msgstr "Идэвхгүйг хаах"

#: crates/ui-egui/src/editor/document.rs:593
msgid "Close Inactive Views"
msgstr "Идэвхгүй харагдацуудыг хаах"

#: crates/ui-egui/src/editor/tabs.rs:303
